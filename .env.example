# Railway sets PORT automatically.

# Public site URL (used for Stripe return links)
SITE_URL=https://feedmyfarmfriends.com

# --- Database ---
# Add a MySQL service in Railway and reference its variable:
#   MYSQL_URL=${{MySQL.MYSQL_URL}}
MYSQL_URL=

# Long random string; generate with:  openssl rand -hex 32
SESSION_SECRET=
# Seeds the FIRST admin account on boot, then does nothing. Remove after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe ---
STRIPE_SECRET_KEY=
# Price ID of the monthly membership (Stripe dashboard > Product catalog)
STRIPE_PRICE_MEMBERSHIP=
# Signing secret of the webhook pointed at https://<site>/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare Stream (live cams) ---
# The "customer-XXXX" part of your Stream URLs, without "customer-"
CF_STREAM_CUSTOMER_CODE=
# Optional but recommended: signed, expiring player links for members only.
# From POST /accounts/{id}/stream/keys: the "id" and the base64 "jwk".
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_JWK=

# --- Feeding ---
# Farm time zone for daily caps and feeding hours
FARM_TZ=America/Chicago
# Seconds before an unconfirmed treat is refunded
FEED_TIMEOUT_SECONDS=60
# A dispenser that hasn't checked in for this long counts as offline
DEVICE_STALE_SECONDS=90
# Local testing only: pretend every dispenser is online and drops instantly
SIMULATE_DISPENSERS=false
